rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Phân quyền cho collection 'users'
    match /users/{userId} {
      // Cho phép đọc nếu người dùng đã đăng nhập
      allow read: if request.auth != null;
      // Chỉ cho phép người dùng tự tạo / chỉnh sửa profile của chính mình (UID khớp nhau)
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Phân quyền cho collection 'events'
    match /events/{eventId} {
      // Cho phép đọc/ghi nếu người dùng đã đăng nhập
      allow read, write: if request.auth != null;
    }
  }
}

