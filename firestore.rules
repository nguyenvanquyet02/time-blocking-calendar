rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc/ghi toàn bộ tài liệu trong collection 'events'
    // Lưu ý: Hiện tại app chưa tích hợp Firebase Auth nên cho phép truy cập công khai.
    // Nếu sau này thêm Auth, có thể đổi thành: allow read, write: if request.auth != null;
    match /events/{eventId} {
      allow read, write: if true;
    }
  }
}
